# Copy thành .env rồi điền key OpenRouter cho chẩn đoán D-Bot và LIVE.
OPENAI_API_KEY=sk-or-xxxx
LLM_MODEL=openai/gpt-4o-mini
# Key riêng cho pipeline D-Bot đầy đủ của 5 kịch bản LIVE.
# Bật true để cho phép runner chuyển key vào đúng tiến trình chẩn đoán.
DEMO_LLM_ENABLED=false
DEMO_LLM_MODEL=qwen/qwen3-30b-a3b-instruct-2507
# DEMO_LLM_API_KEY=sk-or-xxxx
